# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Model used for extraction (agent and baseline). Cheap, non-reasoning, supports strict JSON schema.
INVOICE_AGENT_MODEL=gpt-4.1-mini

# Prices used to report eval cost, USD per 1M tokens. Check https://openai.com/api/pricing before quoting.
INVOICE_AGENT_PRICE_IN=0.40
INVOICE_AGENT_PRICE_OUT=1.60

# Where the CLI keeps LangGraph checkpoints and the ledger (paused reviews survive restarts).
INVOICE_AGENT_STATE_DIR=.state

# Optional: LangSmith tracing (observability). Leave unset to disable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=invoice-review-agent
